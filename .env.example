# Local development uses a SQLite file. Set an absolute or deployment-specific URL only in .env.
DATABASE_URL="file:./dev.db"
PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
NODE_ENV=development
# For a GitHub Pages frontend calling a separate HTTPS API, use:
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
